{
  "name": "campus-companion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present build",
    "dev": "pnpm --parallel --filter @campus/api --filter @campus/admin --filter @campus/worker dev",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:tools": "node --test ./tools/pnpm-child.test.mjs",
    "test": "pnpm test:tools && pnpm build:packages && node ./tools/run-non-native-tests.mjs -r --if-present test && node ./tools/run-native-api-quality.mjs test",
    "test:coverage": "pnpm test:tools && pnpm build:packages && node ./tools/run-non-native-tests.mjs -r --if-present test:coverage && node ./tools/run-native-api-quality.mjs test:coverage",
    "api:lint": "redocly lint docs/api/openapi.yaml --config redocly.yaml",
    "security:static": "node ./tools/run-powershell.mjs ./tools/security-static.ps1",
    "db:generate": "pnpm --filter @campus/database db:generate",
    "db:validate": "pnpm --filter @campus/database db:validate",
    "db:migrate": "pnpm --filter @campus/database db:migrate",
    "db:status": "pnpm --filter @campus/database db:status",
    "admin:bootstrap": "pnpm build:packages && node ./tools/bootstrap-admin.mjs",
    "verify:m0": "node ./tools/run-powershell.mjs ./tools/verify-m0.ps1",
    "verify:m1": "node ./tools/run-powershell.mjs ./tools/verify-m1.ps1",
    "verify:m2": "node ./tools/run-powershell.mjs ./tools/verify-m2.ps1",
    "verify:m3": "node ./tools/run-powershell.mjs ./tools/verify-m3.ps1",
    "verify:m4": "node ./tools/run-powershell.mjs ./tools/verify-m4.ps1",
    "verify:m5": "node ./tools/run-powershell.mjs ./tools/verify-m5.ps1",
    "check": "pnpm verify:m0 && pnpm api:lint && pnpm lint && pnpm security:static && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build && pnpm db:validate && pnpm verify:m1 && pnpm verify:m2 && pnpm verify:m3 && pnpm verify:m4 && pnpm verify:m5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@redocly/cli": "2.38.0",
    "@types/node": "22.19.3",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
