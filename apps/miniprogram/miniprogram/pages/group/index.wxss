.row,.member { display: flex; justify-content: space-between; }
.title { font-size: 44rpx; font-weight: 800; }
.state { color: #176b4d; font-weight: 800; }
.member { margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #f3f8f5; }
button { margin-top: 24rpx; color: #fff; background: #176b4d; }
.secondary { color: #176b4d; background: #eaf5ef; }
.warning { border-color: #ead69d; background: #fff9e8; line-height: 1.7; }
