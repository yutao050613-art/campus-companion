    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@campus/database": "workspace:*",
    "@campus/domain": "workspace:*",
    "@campus/observability": "workspace:*",
    "@campus/verification": "workspace:*",
    "bullmq": "5.79.3",
    "zod": "4.4.3"
  }
}
